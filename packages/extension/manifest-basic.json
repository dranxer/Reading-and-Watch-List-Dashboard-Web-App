{
  "manifest_version": 3,
  "name": "Basic Test Extension",
  "version": "1.0.0",
  "description": "Basic test to see if extensions work",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup-basic.html"
  },
  "background": {
    "service_worker": "background-basic.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-basic.js"]
    }
  ]
} 