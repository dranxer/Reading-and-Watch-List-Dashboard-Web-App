{
  "manifest_version": 3,
  "name": "ReadWatch Tracker",
  "version": "1.0.0",
  "description": "Automatically track and curate your reading and watching habits with AI",
  
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation",
    "cookies",
    "notifications"
  ],
  
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*",
    "http://*/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReadWatch Tracker",
    "default_icon": "icon.svg"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube-debug.js"],
      "run_at": "document_end"
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["*.js", "*.svg"],
      "matches": ["<all_urls>"]
    }
  ]
} 