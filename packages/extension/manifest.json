{
  "manifest_version": 3,
  "name": "ReadWatch",
  "version": "1.1.0",
  "description": "Saves the articles and videos you read to your ReadWatch library.",
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation",
    "cookies",
    "notifications"
  ],
  "host_permissions": [
    "https://readwatch-dashboard.vercel.app/*",
    "http://localhost:3000/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReadWatch",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "exclude_matches": [
        "*://mail.google.com/*",
        "*://inbox.google.com/*",
        "*://outlook.live.com/*",
        "*://outlook.office.com/*",
        "*://outlook.office365.com/*",
        "*://mail.yahoo.com/*",
        "*://mail.proton.me/*",
        "*://*.proton.me/*",
        "*://mail.zoho.com/*",
        "*://mail.zoho.in/*",
        "*://*.icloud.com/*",
        "*://*.fastmail.com/*",
        "*://mail.aol.com/*",
        "*://meet.google.com/*",
        "*://*.zoom.us/*",
        "*://*.zoom.com/*",
        "*://teams.microsoft.com/*",
        "*://teams.live.com/*",
        "*://*.webex.com/*",
        "*://*.whereby.com/*",
        "*://meet.jit.si/*",
        "*://*.gotomeeting.com/*",
        "*://*.bluejeans.com/*",
        "*://*.chime.aws/*",
        "*://app.chime.aws/*",
        "*://*.around.co/*",
        "*://*.skype.com/*",
        "*://web.whatsapp.com/*",
        "*://*.slack.com/*",
        "*://app.slack.com/*",
        "*://*.discord.com/*",
        "*://web.telegram.org/*",
        "*://*.messenger.com/*",
        "*://chat.google.com/*",
        "*://messages.google.com/*",
        "*://teams.cloud.microsoft/*",
        "*://calendar.google.com/*",
        "*://docs.google.com/*",
        "*://drive.google.com/*",
        "*://sheets.google.com/*",
        "*://keep.google.com/*",
        "*://onedrive.live.com/*",
        "*://*.sharepoint.com/*",
        "*://*.dropbox.com/*",
        "*://*.notion.so/*",
        "*://app.notion.com/*",
        "*://*.figma.com/*",
        "*://accounts.google.com/*",
        "*://myaccount.google.com/*",
        "*://login.microsoftonline.com/*",
        "*://account.microsoft.com/*",
        "*://appleid.apple.com/*",
        "*://*.1password.com/*",
        "*://*.lastpass.com/*",
        "*://*.bitwarden.com/*",
        "*://*.paypal.com/*",
        "*://pay.google.com/*",
        "*://wallet.google.com/*",
        "*://*.paytm.com/*",
        "*://*.phonepe.com/*",
        "*://*.razorpay.com/*",
        "*://*.stripe.com/*",
        "*://console.aws.amazon.com/*",
        "*://portal.azure.com/*",
        "*://console.cloud.google.com/*",
        "*://admin.google.com/*",
        "*://*.vercel.com/*",
        "*://app.netlify.com/*"
      ]
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube-debug.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "*.js",
        "*.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}