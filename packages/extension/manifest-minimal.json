{
  "manifest_version": 3,
  "name": "Minimal Extension Test",
  "version": "0.1.0",
  "description": "Minimal test extension",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup-minimal.html"
  },
  "background": {
    "service_worker": "background-minimal.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-minimal.js"],
      "run_at": "document_end"
    }
  ]
} 